# Server configuration
PORT=3000
NODE_ENV="development"

# Secret used to sign/augment session tokens (generate a random 32+ char secret in production)
SESSION_SECRET="change_this_to_a_long_random_production_secret"

# Relational SQLite database file path (or PostgreSQL connection config when external Postgres is used)
DB_PATH="./data/savoria.db"

# Comma-separated allowed CORS origins (optional; defaults to APP_URL and localhost:3000)
ALLOWED_ORIGINS="http://localhost:3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Paystack Payment Gateway (configure via AI Studio Secrets / environment variables)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_CURRENCY="NGN"

