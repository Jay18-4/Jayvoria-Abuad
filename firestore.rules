rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'cakeawesome20@gmail.com'
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'role', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.role in ['CUSTOMER', 'ADMIN'] &&
        data.createdAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'slug', 'sortOrder']) &&
        data.keys().hasOnly(['name', 'slug', 'sortOrder']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 80 && data.slug.matches('^[a-z0-9-]+$') &&
        data.sortOrder is number && data.sortOrder >= 0;
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['name', 'description', 'priceCents', 'categoryId', 'imageUrl', 'isAvailable', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'description', 'priceCents', 'categoryId', 'imageUrl', 'isAvailable', 'updatedAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 600 &&
        data.priceCents is number && data.priceCents > 0 && data.priceCents <= 1000000 &&
        data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 128 &&
        data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 500 &&
        data.isAvailable is bool &&
        data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['orderReference', 'customerUid', 'status', 'totalCents', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['orderReference', 'customerUid', 'status', 'totalCents', 'createdAt', 'updatedAt']) &&
        data.orderReference is string && data.orderReference.size() >= 4 && data.orderReference.size() <= 32 &&
        data.customerUid is string && data.customerUid.size() >= 1 && data.customerUid.size() <= 128 &&
        data.status in ['Pending', 'Confirmed', 'Preparing', 'Ready', 'Completed', 'Cancelled'] &&
        data.totalCents is number && data.totalCents > 0 && data.totalCents <= 10000000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /test/connection {
      allow get: if true;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isSignedIn() && request.auth.uid == userId &&
        isValidUser(incoming()) && incoming().role == 'CUSTOMER' && incoming().createdAt == request.time;
      allow update: if isValidId(userId) && isSignedIn() && isValidUser(incoming()) && (
        isAdmin() ||
        (request.auth.uid == userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']) &&
          incoming().role == existing().role &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time)
      );
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create, update: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming());
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    match /menuItems/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create, update: if isValidId(itemId) && isAdmin() && isValidMenuItem(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isValidId(itemId) && isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (existing().customerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(orderId) && isSignedIn() && isValidOrder(incoming()) &&
        incoming().customerUid == request.auth.uid &&
        incoming().status == 'Pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(orderId) && isSignedIn() && isValidOrder(incoming()) &&
        existing().status != 'Completed' && existing().status != 'Cancelled' && (
          isAdmin() ||
          (existing().customerUid == request.auth.uid &&
            existing().status == 'Pending' &&
            incoming().status == 'Cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
            incoming().updatedAt == request.time)
        );
      allow delete: if false;
    }
  }
}
